# Copy this file to ".env" and fill in real values.
# On the VPS: set DATABASE_URL so data is stored in PostgreSQL.
# On your PC: leave DATABASE_URL out (or delete the line) to use the local data.sqlite file.

DATABASE_URL=postgres://gagan:YOUR_DB_PASSWORD@localhost:5432/videoreview
ADMIN_PASSWORD=change-me-strong-password
PORT=4400

# Only needed for managed Postgres providers that require TLS (not a normal VPS):
# DATABASE_SSL=require
